rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().id == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() > 3 && incoming().email.size() <= 150
        && incoming().role in ['admin', 'tecnico', 'gerente']
        && incoming().createdAt is string && incoming().createdAt.size() <= 50;
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'phone'])
        && (incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100);
      allow delete: if false;
    }
  }
}
