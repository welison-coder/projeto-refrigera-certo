# ==============================================================================
# VARIÁVEIS DE AMBIENTE - REFRIGERA CERTO (HOSTINGER NODE.JS & PRODUÇÃO)
# ==============================================================================

# Porta do servidor Express (na Hostinger geralmente injetada pelo hPanel ou 3000)
PORT=3000

# Modo de ambiente (production para Hostinger)
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. GEMINI_API_KEY (OBRIGATÓRIO PARA IA / GEMINI LIVE)
# ------------------------------------------------------------------------------
# Chave da API do Google AI Studio para recursos inteligentes e Live API.
# Extraia sua chave em: https://aistudio.google.com/app/apikey
# NOTA DE SEGURANÇA: Esta variável roda exclusivamente no servidor Node.js (server.ts)
# e nunca é exposta no frontend/navegador do cliente.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. FIREBASE / FIRESTORE (OPCIONAL - USADO APENAS SE SUBSTITUIR A CONFIG PADRÃO)
# ------------------------------------------------------------------------------
# Por padrão, a aplicação lê diretamente o arquivo `firebase-applet-config.json`
# incluído no projeto. Se você desejar apontar para um projeto Firebase diferente
# no painel da Hostinger, preencha as variáveis abaixo:
# Console do Firebase: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=

# ------------------------------------------------------------------------------
# 3. URL DA APLICAÇÃO (OPCIONAL)
# ------------------------------------------------------------------------------
# URL pública do aplicativo na Hostinger (ex: https://refrigeracerto.com.br)
APP_URL=
